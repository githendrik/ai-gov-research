{
  "name": "ai-gov-research",
  "version": "1.0.0",
  "private": true,
  "description": "AI Governance Weekly - Hugo + Vercel",
  "scripts": {
    "transform": "python3 scripts/transform_docs.py",
    "watch:transform": "python3 scripts/transform_docs.py --watch",
    "build": "python3 scripts/transform_docs.py && hugo --minify --gc",
    "dev": "concurrently -k -n transform,hugo \"python3 scripts/transform_docs.py --watch\" \"hugo server --bind 0.0.0.0 --port 1313\"",
    "serve": "hugo server --bind 0.0.0.0 --port 1313",
    "new:post": "python3 scripts/transform_docs.py"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "license": "MIT"
}
